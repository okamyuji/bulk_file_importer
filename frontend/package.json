{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "oxfmt \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,css,json}\"",
    "stylelint": "stylelint \"src/**/*.css\"",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rails/actioncable": "^8.1.400",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-router": "^8.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "globals": "^17.13.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  }
}
