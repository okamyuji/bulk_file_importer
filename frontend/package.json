{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "oxfmt \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,css,json}\"",
    "stylelint": "stylelint \"src/**/*.css\"",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rails/actioncable": "^8.1.401",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "globals": "^17.14.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "^8.3.7"
  }
}
